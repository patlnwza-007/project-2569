@startuml YuemDee_ERD
!theme plain
top to bottom direction
skinparam linetype ortho

' ==========================================
' ENTITIES DEFINITIONS (Final Normalized 3NF Schema - 13 Entities)
' อัปเดตล่าสุด:
' 1. ยุบ Student/Staff/Admin รวมถึง RoleOverride และ AdminBlockedEmail เป็นตาราง User เดียว รองรับ Django AbstractUser และ UBU SSO
' 2. ยุบ Category และ Position เป็นฟิลด์ category และ location ในตารางสิ่งของทั้ง 3 ประเภทโดยตรง
' 3. ยุบ EquipmentUnit รวมเข้ากับ Equipment และเก็บอัตราค่าปรับต่อวัน (fine_rate_per_day) ไว้ใน DurableMaterial และ Equipment โดยตรง (ตัด SystemSetting ออก)
' 4. เพิ่มฟิลด์ current_location และ moved_at ใน BorrowItem รองรับการแจ้งย้ายที่ตั้ง/ที่อยู่ครุภัณฑ์โดยนักศึกษาเมื่อเกิดเหตุฉุกเฉิน (เช่น น้ำท่วม)
' 5. ใช้ตาราง Review เดียวสำหรับให้ดาวและเขียนอธิบายรีวิวสิ่งของตามชิ้นที่ยืม (ตัด EvaluationQuestion และ EvaluationAnswer ออก)
' ==========================================

entity "Admin (ผู้ดูแลระบบ — Django Backend)" as admin {
  * id : VARCHAR(20) <<PK>>
  --
  * username : VARCHAR(50) <<UK>>
  * name : VARCHAR(100)
  email : VARCHAR(100)
  last_login : DATETIME
  * created_at : DATETIME
}

entity "User (ผู้ใช้งานระบบ — นักศึกษา/เจ้าหน้าที่ UBU SSO)" as user {
  * id : VARCHAR(20) <<PK>>
  --
  * name : VARCHAR(100)
  * email : VARCHAR(100) <<UK>> (@ubu.ac.th)
  * role : ENUM (student / staff)
  role_override : ENUM (student / staff)
  assigned_by : VARCHAR(20) <<FK>>
  phone : VARCHAR(20)
  first_login : DATETIME
  last_login : DATETIME
  blocked : BOOLEAN
  block_reason : TEXT
  blocked_by : VARCHAR(20) <<FK>>
}

entity "Material (วัสดุสิ้นเปลือง — เบิกแล้วหมดไป ไม่ต้องคืน)" as material {
  * id : INT <<PK>>
  --
  * name : VARCHAR(150)
  * location : VARCHAR(150)
  * qty_total : INT
  * qty_available : INT
  * unit : VARCHAR(30)
  purchase_price : DECIMAL(10,2)
  base_status : VARCHAR(50)
  description : TEXT
  image : VARCHAR(255)
}

entity "DurableMaterial (วัสดุคงทน — ยืม-คืนแบบนับจำนวนรวม)" as durable_material {
  * id : INT <<PK>>
  --
  * name : VARCHAR(150)
  * location : VARCHAR(150)
  * qty_total : INT
  * qty_available : INT
  * unit : VARCHAR(30)
  * max_borrow_days : INT
  * fine_rate_per_day : DECIMAL(8,2)
  purchase_price : DECIMAL(10,2)
  base_status : VARCHAR(50)
  description : TEXT
  image : VARCHAR(255)
}

entity "Equipment (ครุภัณฑ์รายชิ้น — มีเลขครุภัณฑ์ประจำตัว)" as equipment {
  * id : INT <<PK>>
  --
  * asset_tag : VARCHAR(50) <<UK>>
  * name : VARCHAR(150)
  * location : VARCHAR(150)
  * unit : VARCHAR(30)
  * max_borrow_days : INT
  * fine_rate_per_day : DECIMAL(8,2)
  purchase_price : DECIMAL(10,2)
  * base_status : ENUM (AVAILABLE / BORROWED / RETURN_PENDING / DAMAGED / MAINTENANCE / RETIRED)
  description : TEXT
  image : VARCHAR(255)
}

entity "BorrowRequest (คำขอยืม/เบิก)" as borrow_request {
  * id : INT <<PK>>
  --
  * user_id : VARCHAR(20) <<FK>>
  approved_by : VARCHAR(20) <<FK>>
  use_date : DATE
  due_date : DATE
  is_special : BOOLEAN
  * status : ENUM (PENDING / BORROWING / RETURN_PENDING / ISSUED / RETURNED / REJECTED / CANCELLED / EXPIRED)
  * created_at : DATETIME
  approved_at : DATETIME
  reject_reason : TEXT
  pickup_photo : TEXT
}

' หมายเหตุ: ใช้ Exclusive Arc FK (เติมค่าแค่คอลัมน์เดียวตามชนิดสิ่งของ: material_id / durable_material_id / equipment_id)
entity "BorrowItem (รายการยืม)" as borrow_item {
  * id : INT <<PK>>
  --
  * borrow_request_id : INT <<FK>>
  material_id : INT <<FK>>
  durable_material_id : INT <<FK>>
  equipment_id : INT <<FK>>
  * qty : INT
  initial_photo : TEXT
  current_location : VARCHAR(255)
  moved_at : DATETIME
}

' หมายเหตุ (3NF): ไม่เก็บ user_id ซ้ำ เพราะอ้างอิงผ่าน borrow_request_id ได้โดยตรง
entity "ReturnRequest (ใบแจ้งส่งคืนพัสดุ)" as return_request {
  * id : INT <<PK>>
  --
  * borrow_request_id : INT <<FK>>
  inspected_by : VARCHAR(20) <<FK>>
  * status : ENUM (RETURN_PENDING / RETURNED / REJECTED)
  return_photo : TEXT
  custom_fine : DECIMAL(10,2)
  fine_paid : BOOLEAN
  fine_reason : TEXT
  note : TEXT
  * created_at : DATETIME
  returned_at : DATETIME
}

' หมายเหตุ (3NF): อ้างอิงสิ่งของที่คืนผ่าน borrow_item_id อย่างเดียว
' ไม่เก็บ item_type / material_id / durable_material_id / equipment_id ซ้ำ
entity "ReturnItem (รายการคืนพัสดุ)" as return_item {
  * id : INT <<PK>>
  --
  * return_request_id : INT <<FK>>
  * borrow_item_id : INT <<FK>>
  * qty_returned : INT
  condition_status : ENUM (NORMAL / DAMAGED / LOST)
  lost_compensation : DECIMAL(10,2)
  lost_paid : BOOLEAN
}

entity "Queue (คิวจองสิ่งของ)" as queue {
  * id : INT <<PK>>
  --
  durable_material_id : INT <<FK>>
  equipment_id : INT <<FK>>
  * user_id : VARCHAR(20) <<FK>>
  * status : ENUM (WAITING / NOTIFIED / EXPIRED / CANCELLED)
  * joined_at : DATETIME
  notified_at : DATETIME
  expired_at : DATETIME
}

entity "Suggestion (ข้อเสนอแนะพัสดุใหม่)" as suggestion {
  * id : INT <<PK>>
  --
  * user_id : VARCHAR(20) <<FK>>
  * name : VARCHAR(150)
  * detail : TEXT
  * status : ENUM (SUBMITTED / ACKNOWLEDGED / PURCHASE_PLAN)
  * created_at : DATETIME
}

entity "PurchasePlan (แผนจัดซื้อพัสดุ)" as purchase_plan {
  * id : INT <<PK>>
  --
  suggestion_id : INT <<FK>>
  * name : VARCHAR(150)
  detail : TEXT
  * created_by : VARCHAR(20) <<FK>>
  * created_at : DATETIME
}

entity "Review (รีวิวสิ่งของตามชิ้นที่ยืม)" as review {
  * id : INT <<PK>>
  --
  * borrow_item_id : INT <<FK>>
  * user_id : VARCHAR(20) <<FK>>
  material_id : INT <<FK>>
  durable_material_id : INT <<FK>>
  equipment_id : INT <<FK>>
  * rating : INT (1-5 ดาว)
  comment : TEXT
  * created_at : DATETIME
}

' หมายเหตุ (3NF): ค้นหาสิ่งของจาก Equipment / DurableMaterial ก่อน หรือระบุ item_name กรณีป้ายรหัสหลุดหาย
entity "DamageReport (แจ้งอุปกรณ์ชำรุด)" as damage_report {
  * id : INT <<PK>>
  --
  * user_id : VARCHAR(20) <<FK>>
  equipment_id : INT <<FK>>
  durable_material_id : INT <<FK>>
  * item_name : VARCHAR(150)
  * location : VARCHAR(255)
  * symptom : TEXT
  photo : TEXT
  * status : ENUM (PENDING / IN_PROGRESS / RESOLVED)
  * created_at : DATETIME
}

' ==========================================
' RELATIONSHIPS & CARDINALITIES
' ==========================================

admin ||--o{ user : "กำหนดสิทธิ์พิเศษ / สั่งระงับสิทธิ์ (assigned_by / blocked_by)"

user ||--o{ borrow_request : "ยื่นคำขอยืม (submits)"
user ||--o{ borrow_request : "อนุมัติคำขอยืม (approves)"
borrow_request ||--|{ borrow_item : "ประกอบด้วยรายการยืม (contains_items)"
material ||--o{ borrow_item : "ถูกเบิกในรายการ"
durable_material ||--o{ borrow_item : "ถูกยืมในรายการ"
equipment ||--o{ borrow_item : "ถูกยืมในรายการ"

borrow_request ||--o{ return_request : "แจ้งส่งคืน (has_returns)"
user ||--o{ return_request : "ตรวจรับคืน (inspects)"
return_request ||--|{ return_item : "ประกอบด้วยรายการคืน (contains_return_items)"
borrow_item ||--o{ return_item : "อ้างอิงรายการยืม (returned_via)"

durable_material ||--o{ queue : "มีคิวจอง"
equipment ||--o{ queue : "มีคิวจอง"
user ||--o{ queue : "ต่อคิว (joins_queue)"

user ||--o{ suggestion : "เสนอแนะ (proposes)"
suggestion |o--o| purchase_plan : "โอนเข้าแผนจัดซื้อ (promoted_to)"
user ||--o{ purchase_plan : "จัดการแผนจัดซื้อ (manages)"

borrow_item ||--o| review : "ถูกรีวิวหลังยืม (reviewed_by)"
user ||--o{ review : "เขียนรีวิว (writes_review)"
material |o--o{ review : "มีรีวิว"
durable_material |o--o{ review : "มีรีวิว"
equipment |o--o{ review : "มีรีวิว"

user ||--o{ damage_report : "แจ้งปัญหา (reports)"
equipment |o--o{ damage_report : "อ้างอิงครุภัณฑ์ที่ชำรุด"
durable_material |o--o{ damage_report : "อ้างอิงวัสดุคงทนที่ชำรุด"

@enduml
